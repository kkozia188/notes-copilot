# 对话后端：
#   cli（默认）— 调用本机 Claude Code（claude -p），使用你自己的 Claude 登录/订阅，无需 API Key
#   api        — 直接调用 Anthropic API，需要 ANTHROPIC_API_KEY
NOTES_COPILOT_BACKEND=cli

# 仅 api 后端需要（https://platform.claude.com/settings/keys）
# ANTHROPIC_API_KEY=sk-ant-...

# 可选
# NOTES_COPILOT_MODEL=claude-opus-5-5   # cli 后端默认用 Claude Code 自己的默认模型
# NOTES_COPILOT_EFFORT=medium           # low | medium | high | xhigh | max
# NOTES_COPILOT_CLAUDE_BIN=claude       # Claude Code 可执行文件路径
# PORT=8787
