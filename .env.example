# 对话后端：
#   codex（默认）— 调用已安装并登录的 Codex CLI，复用本机模型和供应商配置
#   cli          — 调用本机 Claude Code（claude -p）
#   api          — 调用 Anthropic API，需要 ANTHROPIC_API_KEY
NOTES_COPILOT_BACKEND=codex

# 可选：不设置模型时，Codex 使用 ~/.codex/config.toml 中的模型
# NOTES_COPILOT_MODEL=gpt-5.6-sol
# NOTES_COPILOT_EFFORT=medium           # low | medium | high | xhigh
# NOTES_COPILOT_CODEX_BIN=codex         # 可执行文件路径
# NOTES_COPILOT_CLAUDE_BIN=claude
# ANTHROPIC_API_KEY=sk-ant-...
# HOST=127.0.0.1
# PORT=8787
